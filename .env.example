# Copy this file to `.env` and fill in the values (ask Jaffar for them). Never commit `.env`.

# Key every request must send in the X-API-Key header
API_KEY=

# Azure SQL database (chat history, read-only)
SQL_SERVER=
SQL_PORT=1433
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=gpt-5.2
CLASSIFIER_MODEL=gpt-5-mini
EMBED_MODEL=text-embedding-3-small

# OCR webhook (scanned PDFs and images)
OCR_URL=

# Optional
# CORS_ORIGINS=*   # comma-separated frontend origins
